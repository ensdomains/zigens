# RPC URL
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Network Configuration
# sepolia | mainnet | base. Base is manifest-only: NETWORK=base requires
# MANIFEST_PATH (start from manifests/base.zon) — there are no code defaults.
NETWORK=sepolia
# NOTE: not the sync origin. A fresh database starts at the network's V1 era
# start automatically; the stored cursor takes over after that. This value only
# floors undo-log pruning and seeds the status display. To force a different
# start, use --from-block (resets the cursor).
START_BLOCK=0
# Optional bounded sync (stop at this block instead of following the head):
# END_BLOCK=
# Optional contract manifest (Task 08 — config as data). When set, contract addresses
# + deployment blocks are loaded from this .zon file instead of the hardcoded switch,
# so a redeployment is a config edit, not a recompile. Empty = use the code defaults.
# See manifests/README.txt and the committed manifests/{sepolia,mainnet}.zon.
# MANIFEST_PATH=manifests/sepolia.zon

# Indexer Configuration
POLL_INTERVAL=12
BATCH_SIZE=1000
# Fail-fast watchdog: exit(1) after this many minutes of continuous sync-cycle
# failure while the network probe reports healthy, so the container restart
# policy revives the process (restart cures process-local rot such as a frozen
# TLS certificate-validation clock). 0 disables.
# SYNC_FAILURE_EXIT_MINUTES=15

# Rate Limiting
# The API's INBOUND per-IP HTTP limit (burst = 2x this). Must be set on the API
# service: the indexer reads the same name for its own outbound RPC throttle, so
# setting it only there leaves the API on its code default.
RATE_LIMIT_PER_SECOND=10
# The indexer's OUTBOUND RPC throttle. Falls back to RATE_LIMIT_PER_SECOND when
# unset, so existing deployments are unchanged; set it to tune RPC pacing without
# touching the public API limit.
# RPC_RATE_LIMIT_PER_SECOND=120
#
# Halve the RPC rate whenever the provider throttles us (HTTP 429, or a 429-ish
# JSON-RPC error over HTTP 200), stepping back up once it goes quiet. Without it
# the configured rate was the only input and provider feedback was discarded.
# Decreases are logged. Set to 0 to restore the previous fixed-rate behaviour.
# RPC_BACKPRESSURE_ENABLED=1
# Trusted reverse-proxy hops for per-IP rate limiting. 0 (default) keys on the direct
# TCP peer. Set to the number of trusted proxies in front of the API (e.g. 1 for a single
# load balancer) to key on the real client IP from X-Forwarded-For instead. Only enable
# behind a proxy YOU control that sets/overwrites X-Forwarded-For — otherwise clients can
# spoof it to evade limits.
TRUSTED_PROXY_HOPS=0

# Database
# Backend: "sqlite" (default) or "postgres". If unset, inferred from DATABASE_URL's
# scheme (postgres:// → postgres), else sqlite.
# DATABASE_BACKEND=sqlite
# SQLite database file (used when backend is sqlite):
DATABASE_PATH=./data/ens.db
# Postgres connection URL (used when backend is postgres):
# DATABASE_URL=postgres://user:password@127.0.0.1:5432/ens
# Managed Postgres (e.g. Neon) requires TLS — keep sslmode in the URL and build
# with `zig build -Dpg-tls=true` (the Docker image does this). Use the DIRECT
# endpoint, NOT the -pooler one (pgbouncer transaction mode breaks prepared stmts):
# DATABASE_URL=postgresql://user:password@ep-xxx-123.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# THIS APPLIES TO BOTH SERVICES, not just the indexer. A transaction-mode pooler
# (pgbouncer, PgDog, Neon's -pooler, RDS Proxy, Supavisor) hands out a server
# connection per TRANSACTION, which interacts with two things the code relies on:
#   1. Session state — POOLER-DEPENDENT. pgbouncer in transaction mode drops a
#      connection-scoped `SET`, so no statement timeout would be in force. PgDog
#      (measured: 0.1.60, six clients multiplexed onto one backend) virtualises
#      session parameters, so there it survives. Don't rely on either — put the
#      timeout somewhere the connection cannot lose it:
#        - behind PgDog, set it per user in users.toml, which PgDog enforces itself:
#            [[users]]
#            name = "api"
#            pooler_mode = "transaction"
#            statement_timeout = 30000   # ms
#            lock_timeout = 10000        # ms
#        - otherwise (direct, or any pooler) set it on the role, applied by the
#          server at connection time:
#            ALTER ROLE <user> SET statement_timeout = '30s';
#      Either way DATABASE_STATEMENT_TIMEOUT becomes redundant, and the startup probe
#      below goes quiet — a timeout IS then in force, which is the question it asks.
#   2. Prepared statements — NO LONGER A CONSTRAINT. The driver sends every statement as
#      one Parse+Bind+Describe+Execute+Sync message group (what libpq's PQexecParams
#      does), so no prepared statement or portal outlives the group and a transaction-
#      mode pooler has no per-connection state to lose. Both services may therefore use
#      a POOLED endpoint, on stock pooler settings.
#      MEASURED, with the same binaries that serve production:
#        API, 3200 concurrent requests through PgDog 0.1.26, stock settings -> 0 errors
#        indexer, same block range direct vs through PgDog -> byte-identical data in all
#          51 tables (V1 mainnet 131,820 events; V2 sepolia 26,856 events)
#      For contrast, the previous split-round-trip driver failed 176 of 320 requests on
#      the same pooler, with SQLSTATE 08P01 ("bind message supplies N parameters, but
#      prepared statement \"\" requires M") and 26000 — and, when two colliding statements
#      took the same parameter count, no error at all: one query's arguments bound onto
#      another's plan and the wrong rows came back. None of the workarounds that used to
#      be needed are needed now: no `prepared_statements = "extended_anonymous"`, no
#      `pooler_mode = "session"`, no direct-endpoint requirement.
#      Parameters go out in TEXT format with their types unspecified, so a parameter
#      feeding an OVERLOADED function needs a cast (`generate_series(?::bigint, ...)`),
#      exactly as before. One consequence worth knowing: a syntax or missing-relation
#      error now surfaces at the first step/exec rather than at prepare, because Parse
#      travels with Execute.
#
# ONE DATABASE_URL IS ENOUGH. Both services can share it. The per-service overrides
# below exist for OPERATIONAL reasons, not correctness: separate credentials (a
# read-only role for the API, see the grant section), a different endpoint per service,
# or isolating one service's connections from the other's. Unset, each falls back to
# DATABASE_URL.
# The API has a best-effort startup probe for (1) (SET/SHOW in
# storage/drivers/postgres.zig), but SILENCE PROVES NOTHING: it cannot see (2) at all,
# and it stays quiet on a pooler that virtualises session state, such as PgDog.
#
# Per-service overrides, so the writer can stay direct while the reader is pooled
# (both fall back to DATABASE_URL when unset):
# INDEXER_DATABASE_URL=postgresql://...   # optional: only to give the writer its own
#                                         # credentials or endpoint
# API_DATABASE_URL=postgresql://...       # optional: e.g. the read-only role below
#
# Least privilege for the API. It is a read-only consumer of the indexer's tables
# (storage/db_open.zig openFromConfigReadonly) and runs no DDL, so grant it SELECT
# and nothing else — EXCEPT `resolution_cache`, which it upserts and prunes when
# live resolution is on. Note those writes are `catch {}`-swallowed, so a plain
# SELECT-only role does not error, it silently disables the cache and re-resolves
# over RPC every lookup:
#   GRANT SELECT ON ALL TABLES IN SCHEMA public TO api_reader;
#   GRANT INSERT, UPDATE, DELETE ON resolution_cache TO api_reader;
# ON ALL TABLES only covers tables that exist WHEN YOU RUN IT. The indexer adds
# tables over time (resolution_cache/finality via ensureSchema, and the schema
# pre-pass recreates the whole set whenever one is missing — that is how
# event_attributions arrived), so without default privileges the API starts failing
# with "permission denied" on whatever is added next. Name the role the INDEXER
# connects as, because default privileges are per-creating-role:
#   ALTER DEFAULT PRIVILEGES FOR ROLE <indexer_role> IN SCHEMA public
#     GRANT SELECT ON TABLES TO api_reader;
# API read-connection pool size (acquire-per-request). Keep within the server's
# max_connections; on Neon free/small compute start modest (indexer needs one too):
# DATABASE_POOL_SIZE=8
# Postgres tuning: per-statement timeout in seconds (default 120), server-side
# and synchronous_commit override
# (on|off|local|remote_write|remote_apply):
# DATABASE_STATEMENT_TIMEOUT=120
# DATABASE_SYNCHRONOUS_COMMIT=

# Rainbow table (label healing); point at an existing copy to skip download:
# RAINBOW_PATH=./data/ens_rainbow.db

# API Server
API_PORT=8080
API_ENABLED=true
# GraphQL query governors (defaults 10 / 10000):
# GRAPHQL_MAX_DEPTH=10
# GRAPHQL_MAX_COST=10000
# Log a warn line (duration, depth, cost, outcome, query excerpt) for any
# execution at or above this many ms (default 2000):
# GRAPHQL_SLOW_QUERY_MS=2000
# Per-request wall-clock timeout in ms (default 10000) and connection cap
# (default 512; excess connections get 503):
# REQUEST_TIMEOUT_MS=10000
# MAX_CONCURRENT_CONNECTIONS=512
# Admin credentials. Webhook admin endpoints are fail-closed: unset creds =
# admin surface disabled (set WEBHOOKS_ALLOW_UNAUTHENTICATED=true only for
# isolated dev). The internal token gates /internal/* (e.g. verify-primary).
# WEBHOOK_ADMIN_USERNAME=
# WEBHOOK_ADMIN_PASSWORD=
# WEBHOOKS_ALLOW_UNAUTHENTICATED=false
# INTERNAL_ADMIN_TOKEN=
# INTERNAL_RATE_LIMIT_PER_SECOND=2
# SQLite journal mode: WAL (default) is right for local disks; set DELETE on
# network/FUSE filesystems where WAL's shared-memory mmap is unsupported.
# SQLITE_JOURNAL_MODE=WAL

# Status Server (optional - leave empty to disable)
# STATUS_PORT=3001

# Webhooks
WEBHOOKS_ENABLED=false
WEBHOOK_MAX_RETRIES=3
WEBHOOK_DB_PATH=./data/webhooks.db

# Memory Management
CHECKPOINT_INTERVAL=100

# Metrics (Prometheus text format at GET /metrics)
METRICS_ENABLED=false

# Finality signalling (Task 09). When on, the indexer fetches the chain's safe/finalized
# block tags each poll and persists them; the additive GraphQL `_finality` field then
# reports head/safe/finalized positions + an isStale signal. Off by default (the field is
# always present but returns nulls until enabled). Cheap: 2 extra RPC calls per poll.
# FINALITY_ENABLED=false

# API only. On a deployment with NO finality data, /ready, /coverage, `_coverage` and
# the ensv2_coverage_stale gauge report stale=true once any indexed protocol has gone
# this many seconds without committing a batch, or when nothing has synced at all.
# Ignored when finality data is present (the safe-head comparison wins).
# Off by default (0 / off). The shipped docker-compose files set 3600.
# - Must exceed your longest healthy batch: bulk-sync batches have taken 10-44 min.
# - --backfill and END_BLOCK-pinned deployments do not advance the head and WILL read
#   stale; set 0 for those.
# - Compares the indexer host's clock with the API host's; keep both NTP-synced.
# COVERAGE_STALE_AFTER_SECONDS=3600

# Query-time Resolution (all OFF by default — served values are byte-identical
# until explicitly enabled). See docs/tasks/04-06.
# Dedicated resolution RPC endpoint (defaults to RPC_URL when unset):
# RESOLVE_RPC_URL=
# Soft freshness window (seconds) for cached resolution answers:
# RESOLVE_CACHE_TTL_S=300
# Forward-verify reverse/primary-name claims on-chain (Task 05):
# PRIMARY_VERIFY_ENABLED=false
# Live ENSIP-10 Universal Resolver fallback on an indexed MISS (Task 06). Requires
# RESOLVE_UNIVERSAL_RESOLVER to be set to a non-zero address to actually resolve:
# RESOLVE_LIVE_ENABLED=false
# UniversalResolver contract address for live resolution (per-network default is
# unset until wired; set it here to enable Task 06 on your network):
# RESOLVE_UNIVERSAL_RESOLVER=
# EIP-3668 CCIP-Read offchain completion (Task 07). Requires RESOLVE_LIVE_ENABLED.
# WARNING: enabling this makes the API issue outbound HTTP to name-controlled gateway
# URLs (an SSRF surface) — enable only behind a trusted network / with monitoring:
# RESOLVE_CCIP_ENABLED=false
# CCIP_GATEWAY_TIMEOUT_MS=5000
# CCIP_MAX_REDIRECTS=4

# Provider ceiling on JSON-RPC batch sizes (requests per HTTP batch); 0 = unlimited.
# Set (e.g. 3) when a provider rejects large batches.
RPC_MAX_BATCH_REQUESTS=0

# Zig release profile for Docker image builds (compose build arg, not runtime).
# ReleaseSafe (default) keeps bounds/overflow checks active in production;
# ReleaseFast trades those checks for speed — opt in deliberately, per deploy.
# ZIG_OPTIMIZE=ReleaseSafe

# Executable set for Docker image builds (compose build arg, not runtime).
# v2api compiles only ensv2-indexer-v2 + ensv2-api (what every compose service
# runs) — roughly half the build time of `all` (combined + V1 binaries too).
# ZIG_TARGETS=v2api

# Buffer V2 events during bulk sync and flush them as multi-row inserts
# (default on). The per-event round trips were the measured Neon bulk-sync
# bottleneck. Ops escape hatch: 0 restores per-event direct writes.
# V2_EVENT_BUFFER=1

# MCP agent endpoint (POST /mcp on the API server): lets AI agents discover
# and query ENSv2 over the Model Context Protocol — GraphQL taught via the
# graphql-query tool, get-graphql-schema for types, examples resource.
# Default off.
#
# IT IS UNAUTHENTICATED AND READ-ONLY, exactly like POST /graphql: anyone who can
# reach the port can call it. It crosses the same governors (per-IP rate limit,
# 64KB body cap, request timeout, query complexity) and refuses mutations. Put it
# behind the same thing that fronts /graphql.
# MCP_ENABLED=1
#
# Comma-separated Origin allow-list for POST /mcp.
# A request with NO Origin header — every CLI and agent client — is always
# allowed. A request that DOES carry one is a browser, and is only allowed if it
# matches this list, even when the list is unset: Streamable HTTP makes that
# validation a MUST (DNS rebinding). So to call /mcp from a web page you must
# name its origin here. `*` allows any browser origin, visibly.
# MCP_ALLOWED_ORIGINS=https://your-app.example

# Prefetch names rows once per dispatch batch so the ResolverUpdated storm
# (~86% of V2 bulk-sync events) is served from memory instead of one or two
# point lookups per event — the largest round-trip class after event
# batching. Ops escape hatch: 0 restores per-event DB lookups.
# NAME_PREFETCH=1
