# RPC URL
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Network Configuration
# sepolia | mainnet | base. Base is manifest-only: NETWORK=base requires
# MANIFEST_PATH (start from manifests/base.zon) — there are no code defaults.
NETWORK=sepolia
# NOTE: not the sync origin. A fresh database starts at the network's V1 era
# start automatically; the stored cursor takes over after that. This value only
# floors undo-log pruning and seeds the status display. To force a different
# start, use --from-block (resets the cursor).
START_BLOCK=0
# Optional bounded sync (stop at this block instead of following the head):
# END_BLOCK=
# Optional contract manifest (Task 08 — config as data). When set, contract addresses
# + deployment blocks are loaded from this .zon file instead of the hardcoded switch,
# so a redeployment is a config edit, not a recompile. Empty = use the code defaults.
# See manifests/README.txt and the committed manifests/{sepolia,mainnet}.zon.
# MANIFEST_PATH=manifests/sepolia.zon

# Indexer Configuration
POLL_INTERVAL=12
BATCH_SIZE=1000

# Rate Limiting
RATE_LIMIT_PER_SECOND=10
# Trusted reverse-proxy hops for per-IP rate limiting. 0 (default) keys on the direct
# TCP peer. Set to the number of trusted proxies in front of the API (e.g. 1 for a single
# load balancer) to key on the real client IP from X-Forwarded-For instead. Only enable
# behind a proxy YOU control that sets/overwrites X-Forwarded-For — otherwise clients can
# spoof it to evade limits.
TRUSTED_PROXY_HOPS=0

# Database
# Backend: "sqlite" (default) or "postgres". If unset, inferred from DATABASE_URL's
# scheme (postgres:// → postgres), else sqlite.
# DATABASE_BACKEND=sqlite
# SQLite database file (used when backend is sqlite):
DATABASE_PATH=./data/ens.db
# Postgres connection URL (used when backend is postgres):
# DATABASE_URL=postgres://user:password@127.0.0.1:5432/ens
# Managed Postgres (e.g. Neon) requires TLS — keep sslmode in the URL and build
# with `zig build -Dpg-tls=true` (the Docker image does this). Use the DIRECT
# endpoint, NOT the -pooler one (pgbouncer transaction mode breaks prepared stmts):
# DATABASE_URL=postgresql://user:password@ep-xxx-123.us-east-2.aws.neon.tech/neondb?sslmode=require
# API read-connection pool size (acquire-per-request). Keep within the server's
# max_connections; on Neon free/small compute start modest (indexer needs one too):
# DATABASE_POOL_SIZE=8
# Postgres tuning: per-statement timeout in seconds (default 120), server-side
# prepared-statement cache kill-switch, and synchronous_commit override
# (on|off|local|remote_write|remote_apply):
# DATABASE_STATEMENT_TIMEOUT=120
# DATABASE_STMT_CACHE=true
# DATABASE_SYNCHRONOUS_COMMIT=

# Rainbow table (label healing); point at an existing copy to skip download:
# RAINBOW_PATH=./data/ens_rainbow.db

# API Server
API_PORT=8080
API_ENABLED=true
# GraphQL query governors (defaults 10 / 10000):
# GRAPHQL_MAX_DEPTH=10
# GRAPHQL_MAX_COST=10000
# Per-request wall-clock timeout in ms (default 10000) and connection cap
# (default 512; excess connections get 503):
# REQUEST_TIMEOUT_MS=10000
# MAX_CONCURRENT_CONNECTIONS=512
# Admin credentials. Webhook admin endpoints are fail-closed: unset creds =
# admin surface disabled (set WEBHOOKS_ALLOW_UNAUTHENTICATED=true only for
# isolated dev). The internal token gates /internal/* (e.g. verify-primary).
# WEBHOOK_ADMIN_USERNAME=
# WEBHOOK_ADMIN_PASSWORD=
# WEBHOOKS_ALLOW_UNAUTHENTICATED=false
# INTERNAL_ADMIN_TOKEN=
# INTERNAL_RATE_LIMIT_PER_SECOND=2
# SQLite journal mode: WAL (default) is right for local disks; set DELETE on
# network/FUSE filesystems where WAL's shared-memory mmap is unsupported.
# SQLITE_JOURNAL_MODE=WAL

# Status Server (optional - leave empty to disable)
# STATUS_PORT=3001

# Webhooks
WEBHOOKS_ENABLED=false
WEBHOOK_MAX_RETRIES=3
WEBHOOK_DB_PATH=./data/webhooks.db

# Memory Management
CHECKPOINT_INTERVAL=100

# Metrics (Prometheus text format at GET /metrics)
METRICS_ENABLED=false

# Finality signalling (Task 09). When on, the indexer fetches the chain's safe/finalized
# block tags each poll and persists them; the additive GraphQL `_finality` field then
# reports head/safe/finalized positions + an isStale signal. Off by default (the field is
# always present but returns nulls until enabled). Cheap: 2 extra RPC calls per poll.
# FINALITY_ENABLED=false

# Query-time Resolution (all OFF by default — served values are byte-identical
# until explicitly enabled). See docs/tasks/04-06.
# Dedicated resolution RPC endpoint (defaults to RPC_URL when unset):
# RESOLVE_RPC_URL=
# Soft freshness window (seconds) for cached resolution answers:
# RESOLVE_CACHE_TTL_S=300
# Forward-verify reverse/primary-name claims on-chain (Task 05):
# PRIMARY_VERIFY_ENABLED=false
# Live ENSIP-10 Universal Resolver fallback on an indexed MISS (Task 06). Requires
# RESOLVE_UNIVERSAL_RESOLVER to be set to a non-zero address to actually resolve:
# RESOLVE_LIVE_ENABLED=false
# UniversalResolver contract address for live resolution (per-network default is
# unset until wired; set it here to enable Task 06 on your network):
# RESOLVE_UNIVERSAL_RESOLVER=
# EIP-3668 CCIP-Read offchain completion (Task 07). Requires RESOLVE_LIVE_ENABLED.
# WARNING: enabling this makes the API issue outbound HTTP to name-controlled gateway
# URLs (an SSRF surface) — enable only behind a trusted network / with monitoring:
# RESOLVE_CCIP_ENABLED=false
# CCIP_GATEWAY_TIMEOUT_MS=5000
# CCIP_MAX_REDIRECTS=4

# Provider ceiling on JSON-RPC batch sizes (requests per HTTP batch); 0 = unlimited.
# Set (e.g. 3) when a provider rejects large batches.
RPC_MAX_BATCH_REQUESTS=0

# Zig release profile for Docker image builds (compose build arg, not runtime).
# ReleaseSafe (default) keeps bounds/overflow checks active in production;
# ReleaseFast trades those checks for speed — opt in deliberately, per deploy.
# ZIG_OPTIMIZE=ReleaseSafe

# Executable set for Docker image builds (compose build arg, not runtime).
# v2api compiles only ensv2-indexer-v2 + ensv2-api (what every compose service
# runs) — roughly half the build time of `all` (combined + V1 binaries too).
# ZIG_TARGETS=v2api
