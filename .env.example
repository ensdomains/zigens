# RPC URLs
V1_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
V2_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Network Configuration
NETWORK_V1=sepolia
NETWORK_V2=sepolia
START_BLOCK=0

# Indexer Configuration
POLL_INTERVAL=12
BATCH_SIZE=1000
MAX_BLOCKS_PER_REQUEST=1000

# Rate Limiting
RATE_LIMIT_PER_SECOND=10

# Database
DATABASE_PATH=./data/ens.db

# API Server
API_PORT=8080
API_ENABLED=true

# Status Server (optional - leave empty to disable)
# STATUS_PORT=3001

# Webhooks
WEBHOOKS_ENABLED=false
WEBHOOK_MAX_RETRIES=3
WEBHOOK_DB_PATH=./data/webhooks.db

# Memory Management
MAX_MEMORY_MB=512
CHECKPOINT_INTERVAL=100
