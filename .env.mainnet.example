# ENS Mainnet Configuration Example
# Copy this to .env and update with your actual API keys

# RPC URL
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_MAINNET_API_KEY

# Network Configuration
NETWORK=mainnet

# Start Block Options:
# - Full historical sync: START_BLOCK=9380380 (ENS Registry deployment, Feb 2020)
# - Recent only: START_BLOCK=21000000 (or latest block - 1000 for testing)
# - Real-time only: START_BLOCK=0 (will use latest block)
START_BLOCK=9380380

# Indexer Configuration
# Smaller batch size for mainnet (more events per block)
POLL_INTERVAL=12
BATCH_SIZE=10000
MAX_BLOCKS_PER_REQUEST=10000

# Rate Limiting
# Set to match your Alchemy tier
# Free tier: 330 req/s (NOT RECOMMENDED for mainnet)
# Growth tier: 3300 req/s (RECOMMENDED)
RATE_LIMIT_PER_SECOND=3300

# Database
DATABASE_PATH=./data/ens_mainnet.db

# API Server
API_PORT=8080
API_ENABLED=true

# Webhooks
WEBHOOKS_ENABLED=false
WEBHOOK_MAX_RETRIES=3

# Memory Management
MAX_MEMORY_MB=1024
CHECKPOINT_INTERVAL=100

# Metrics
METRICS_ENABLED=true
