# ENS Mainnet Configuration Example
# Copy to .env and fill in your values. Every variable here is read by the
# current binaries; commented lines show the built-in default.

# RPC URL
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_MAINNET_API_KEY

# Network Configuration
NETWORK=mainnet
# Full historical sync from the ENS Registry deployment (Feb 2020). Use a recent
# block instead for a partial/testing sync, or 0 to start from the latest block.
# NOTE: not the sync origin — a fresh mainnet database starts at the 2017
# temp-registrar era (block 3327417) automatically; use --from-block to override.
START_BLOCK=3327417
# Optional bounded sync (stop at this block instead of following the head):
# END_BLOCK=

# Contract manifest (config as data). When set, contract addresses + deployment
# blocks load from this .zon file instead of the hardcoded switch — a
# redeployment is a config edit, not a recompile. See manifests/README.txt.
# NOTE: ENS V2 is not deployed on Ethereum mainnet; the mainnet manifest carries
# zero addresses for the V2 contracts, so V2 indexing is inert and mainnet runs
# V1-only until a V2 deployment is wired here.
# MANIFEST_PATH=manifests/mainnet.zon

# Indexer Configuration
POLL_INTERVAL=12
# Mainnet has more events per block than testnets; 10000 blocks/batch is tuned
# for a Growth-tier RPC. Reduce if your provider throttles eth_getLogs.
BATCH_SIZE=10000

# Rate Limiting (outbound RPC)
# Match your provider tier. Alchemy: free 330 req/s (NOT recommended for a full
# mainnet sync), Growth 3300 req/s.
RATE_LIMIT_PER_SECOND=3300

# Database
# Backend: "sqlite" (default) or "postgres". If unset, inferred from
# DATABASE_URL's scheme (postgres:// -> postgres), else sqlite.
# DATABASE_BACKEND=sqlite
DATABASE_PATH=./data/ens_mainnet.db
# SQLite journal mode: WAL (default) is right for local disks; set DELETE on
# network/FUSE filesystems where WAL's shared-memory mmap is unsupported.
# SQLITE_JOURNAL_MODE=WAL
# Postgres connection URL (used when backend is postgres):
# DATABASE_URL=postgres://user:password@127.0.0.1:5432/ens
# Managed Postgres (e.g. Neon) requires TLS — keep sslmode in the URL and build
# with `zig build -Dpg-tls=true` (the Docker image does this). Use the DIRECT
# endpoint, NOT the -pooler one:
# DATABASE_URL=postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require
# API read-connection pool size (acquire-per-request; default 10). Keep within
# the server's max_connections — the indexer needs a connection too:
# DATABASE_POOL_SIZE=10
# Postgres tuning: per-statement timeout in seconds (default 120), server-side
# prepared-statement cache kill-switch, and synchronous_commit override
# (on|off|local|remote_write|remote_apply — "off" trades a small crash window
# for much faster bulk sync on remote/managed PG):
# DATABASE_STATEMENT_TIMEOUT=120
# DATABASE_SYNCHRONOUS_COMMIT=

# Rainbow table (label healing). ~6 GB download on first start when enabled in
# the container (DOWNLOAD_RAINBOW); point RAINBOW_PATH at an existing copy to
# skip the download.
# RAINBOW_PATH=./data/ens_rainbow.db

# API Server
API_PORT=8080
API_ENABLED=true
# GraphQL query governors (defaults 10 / 10000):
# GRAPHQL_MAX_DEPTH=10
# GRAPHQL_MAX_COST=10000
# Per-request wall-clock timeout in ms (default 10000) and connection cap
# (default 512; excess connections get 503):
# REQUEST_TIMEOUT_MS=10000
# MAX_CONCURRENT_CONNECTIONS=512
# Trusted reverse-proxy hops for per-IP rate limiting. 0 (default) keys on the
# direct TCP peer; set to the number of proxies YOU control in front of the API
# to key on the real client IP from X-Forwarded-For.
TRUSTED_PROXY_HOPS=0
# Admin credentials. Webhook admin endpoints are fail-closed: unset creds =
# admin surface disabled (set WEBHOOKS_ALLOW_UNAUTHENTICATED=true only for
# isolated dev). The internal token gates /internal/* (e.g. verify-primary).
# WEBHOOK_ADMIN_USERNAME=
# WEBHOOK_ADMIN_PASSWORD=
# WEBHOOKS_ALLOW_UNAUTHENTICATED=false
# INTERNAL_ADMIN_TOKEN=
# INTERNAL_RATE_LIMIT_PER_SECOND=2

# Status Server (optional - leave empty to disable)
# STATUS_PORT=3001

# Webhooks
WEBHOOKS_ENABLED=false
WEBHOOK_MAX_RETRIES=3
WEBHOOK_DB_PATH=./data/webhooks.db

# Memory Management
CHECKPOINT_INTERVAL=100

# Metrics (Prometheus text format at GET /metrics)
METRICS_ENABLED=true

# Finality signalling. The indexer fetches safe/finalized block tags each poll
# and persists them; GraphQL `_finality` + per-domain finality annotations and
# the finality gauges on /metrics then report real positions. Cheap (2 extra
# RPC calls per poll) — recommended on for production.
FINALITY_ENABLED=true

# Query-time Resolution (all OFF by default — served values are byte-identical
# until explicitly enabled).
# Dedicated resolution RPC endpoint (defaults to RPC_URL when unset):
# RESOLVE_RPC_URL=
# Soft freshness window (seconds) for cached resolution answers (default 300):
# RESOLVE_CACHE_TTL_S=300
# Forward-verify reverse/primary-name claims on-chain:
# PRIMARY_VERIFY_ENABLED=false
# Live ENSIP-10 Universal Resolver fallback on an indexed MISS. Requires
# RESOLVE_UNIVERSAL_RESOLVER set to a non-zero address — there is no built-in
# mainnet default; set your deployment's UniversalResolver here:
# RESOLVE_LIVE_ENABLED=false
# RESOLVE_UNIVERSAL_RESOLVER=
# EIP-3668 CCIP-Read offchain completion. Requires RESOLVE_LIVE_ENABLED.
# WARNING: enables outbound HTTP to name-controlled gateway URLs (an SSRF
# surface) — enable only behind a trusted network / with monitoring:
# RESOLVE_CCIP_ENABLED=false
# CCIP_GATEWAY_TIMEOUT_MS=5000
# CCIP_MAX_REDIRECTS=4
