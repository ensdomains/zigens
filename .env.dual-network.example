# Dual-Network Configuration Example
# L1 = Mainnet (ENS V1 Production)
# L2 = Sepolia (ENS V2 Testnet)

# Network Configuration - DUAL NETWORK MODE
NETWORK_L1=mainnet
NETWORK_L2=sepolia

# RPC URLs
L1_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_MAINNET_API_KEY
L2_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_SEPOLIA_API_KEY

# Start Block (uses L1 deployment block)
START_BLOCK=9380380  # ENS V1 mainnet deployment

# Indexer Configuration
POLL_INTERVAL=12
BATCH_SIZE=10000     # Smaller for mainnet
MAX_BLOCKS_PER_REQUEST=10000

# Rate Limiting
RATE_LIMIT_PER_SECOND=100  # Adjust based on your Alchemy tier

# Database
DATABASE_PATH=./data/ens_dual_network.db

# API Server
API_PORT=8080
API_ENABLED=true

# Webhooks
WEBHOOKS_ENABLED=false
WEBHOOK_MAX_RETRIES=3

# Memory Management
MAX_MEMORY_MB=1024
CHECKPOINT_INTERVAL=100

# Metrics
METRICS_ENABLED=true
