# Zig
.zig-cache/
zig-out/
zig-pkg/

# Generated from schema.graphql by tools/generate_introspection.py on every
# `zig build` (see build.zig — api_exe.step.dependOn(&generate_schema.step)).
src/api/introspection.json

# Database
*.db
*.db-journal
*.sqlite
*.sqlite3

# Configuration
config.json

# Data
data/
rainbow_data/

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Node (tools/conformance JS test deps)
node_modules/

# Environment
.env
.env.local

# Environment — every .env except the committed templates and the
# placeholder-only test fixture. Keeps real credentials out by default.
.env.*
!.env.example
!.env.*.example
!.env.test

# Local working notes: docs/ is local-by-default, so a new design note or
# audit can never be published by an `add -A`. Published docs are listed.
/docs/*
!/docs/DEPLOYMENT.md
!/docs/RUN.md
!/docs/TESTING.md
!/docs/postgresql-migration-plan.md

# Agent/editor scratch
CLAUDE.md
.claude/
__pycache__/

# Stray build output
/test_arraylist
/ramp.csv
