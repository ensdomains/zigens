# ENSv2 Indexer + API - Coolify Environment Variables
# Copy this to your Coolify environment settings

# RPC URL (Sepolia for testnet, mainnet for production)
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Network configuration
NETWORK=sepolia

# Database path (inside container)
DATABASE_PATH=/app/data/ens.db

# Rainbow table (auto-downloaded on first startup)
# Downloads ~6GB from Google Cloud Storage, takes 10-20 minutes
RAINBOW_PATH=/app/data/ens_rainbow.db
DOWNLOAD_RAINBOW=true

# API settings
API_PORT=8080
GRAPHQL_MAX_DEPTH=10
GRAPHQL_MAX_COST=10000

# Indexer settings
BATCH_SIZE=10000
POLL_INTERVAL=12
RATE_LIMIT_PER_SECOND=25

# Status server
STATUS_PORT=3001

# Webhooks (optional)
WEBHOOKS_ENABLED=false

# Metrics (optional)
METRICS_ENABLED=false
